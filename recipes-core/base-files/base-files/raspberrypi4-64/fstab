# The fstab (/etc/fstab) (or file systems table) file is a system configuration
# file on Debian systems. The fstab file typically lists all available disks and
# disk partitions, and indicates how they are to be initialized or otherwise
# integrated into the overall system's file system.
# See https://wiki.debian.org/fstab

# Default fstab entries
/dev/root            /                    auto       defaults              1  1
proc                 /proc                proc       defaults              0  0
devpts               /dev/pts             devpts     mode=0620,ptmxmode=0666,gid=5      0  0
tmpfs                /run                 tmpfs      mode=0755,nodev,nosuid,strictatime 0  0
tmpfs                /var/volatile        tmpfs      defaults              0  0

# Custom fstab entries for ADU raspberrypi3.
# NOTE: these entries must be kept in sync with the corresponding .wks file.

# Mount the boot partition that contains the bootloader.
/dev/mmcblk0p1  /boot   vfat    defaults,sync   0   0

# Mount the ADU specific partition for reading configuration and writing logs.
# This partition is only accessible by adu user/group.
# ext4 provides proper ACL support and journaling for reliability.
/dev/mmcblk0p4  /adu    ext4    defaults   0   2

# Optional customer data partition for application-specific storage.
# FAT32 allows easy cross-platform access.
# nofail option prevents boot failure if partition is not present.
#
# IMPORTANT: This is the 5th partition and requires GPT (GUID Partition Table).
# MBR (Master Boot Record) only supports 4 primary partitions.
# To enable this partition:
#   1. Add 'bootloader --ptable gpt' to wic/adu-raspberrypi.wks
#   2. Uncomment the line below
#   3. Test boot on hardware - Raspberry Pi firmware may have limited GPT support
#
# WARNING: Partition numbering (/dev/mmcblk0p5) assumes GPT with 5 partitions.
# With MBR and extended partitions, numbering may differ.
#
#/dev/mmcblk0p5  /data   vfat    defaults,nofail   0   0
