[Unit]
Description=ADU Boot Validation Service
Documentation=https://github.com/Azure/iot-hub-device-update
After=network-online.target systemd-journald.service
Before=multi-user.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/adu-boot-validation.sh
RemainAfterExit=yes
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

# Restart policy - don't restart on failure (we want to reboot instead)
Restart=no

[Install]
WantedBy=multi-user.target
