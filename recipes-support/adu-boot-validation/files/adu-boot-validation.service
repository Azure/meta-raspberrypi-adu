[Unit]
Description=ADU Boot Validation - Rollback detection and health checks for A/B updates
Documentation=https://github.com/Azure/iot-hub-device-update
After=local-fs.target network.target
Before=deviceupdate-agent.service multi-user.target
Wants=network.target
ConditionPathExists=/usr/bin/adu-boot-validation.sh

[Service]
Type=oneshot
ExecStart=/usr/bin/adu-boot-validation.sh
RemainAfterExit=yes
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

# Security hardening
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/adu /var/lib/adu/states /var/lock /var/log/adu /var/run

# Don't restart on failure - we want to continue boot
Restart=no

[Install]
WantedBy=multi-user.target
